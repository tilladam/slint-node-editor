// Test UI for integration testing
// Extends minimal example with all callbacks exposed for testing

import { Button } from "std-widgets.slint";

import {
    NodeEditor,
    BoxSelectionModifier,
    BaseNode,
    Pin,
    PinTypes,
    LinkData,
    ViewportState,
    GeometryVersion,
    DragState,
    HoverState,
    LinkCreation,
    LinkCreationState,
    NodeEditorInternalCallbacks,
    NodeEditorComputations,
    LinkPath,
} from "@nodeeditor";

// Access the field inside the repeated node without exposing library internals.
global NodeField {
    in-out property <int> focus-version: 0;
    in-out property <bool> has-focus: false;
}

export struct NodeData {
    id: int,
    title: string,
    x: float,
    y: float,
    /// Projected from the application's selection (the editor holds none)
    selected: bool,
}

// Re-export for Rust
export { BoxSelectionModifier, LinkData, GeometryVersion, DragState, HoverState, LinkCreation, LinkCreationState, NodeEditorInternalCallbacks, NodeEditorComputations }

component SimpleNode inherits BaseNode {
    in property <bool> focus-test-enabled: false;
    callback embedded-control-clicked();
    in property <string> title: "Node";
    in property <length> configured-width: 150px;
    in property <length> configured-height: 100px;
    in property <int> input-pin-id: root.node-id * 2;
    in property <int> input-pin-node-id: root.node-id;
    in property <int> input-pin-type: PinTypes.input;
    in property <bool> input-pin-visible: true;
    in property <bool> input-pin-enabled: true;
    node-width: configured-width;
    node-height: configured-height;

    Rectangle {
        width: 100%;
        height: 100%;
        background: root.selected ? #4a6a9a : #333;
        border-radius: 4px;
        border-width: 1px;
        border-color: #666;

        Text {
            text: root.title;
            color: white;
            font-size: 14px;
        }
    }

    // Single input pin
    Pin {
        x: 0px;
        y: root.node-height / 2 - self.height / 2;
        pin-id: root.input-pin-id;
        node-id: root.input-pin-node-id;
        pin-type: root.input-pin-type;
        visible: root.input-pin-visible;
        enabled: root.input-pin-enabled;
        node-screen-x: root.screen-x;
        node-screen-y: root.screen-y;
    }

    // Single output pin
    Pin {
        x: root.node-width - self.width;
        y: root.node-height / 2 - self.height / 2;
        pin-id: root.node-id * 2 + 1;
        node-id: root.node-id;
        pin-type: PinTypes.output;
        node-screen-x: root.screen-x;
        node-screen-y: root.screen-y;
    }

    Button {
        x: 50px;
        y: 10px;
        width: 60px;
        height: 28px;
        text: "Action";
        clicked => { root.embedded-control-clicked(); }
    }

    field := TextInput {
        visible: root.focus-test-enabled;
        x: 20px;
        y: 70px;
        width: 60px;
        height: 20px;
        changed has-focus => {
            if root.node-id == 1 {
                NodeField.has-focus = self.has-focus;
            }
        }
    }
    property <int> field-focus-version: NodeField.focus-version;
    changed field-focus-version => {
        if root.node-id == 1 {
            field.focus();
        }
    }
}

export component MainWindow inherits Window {
    title: "Test Node Editor";
    width: 800px;
    height: 600px;

    in property <[NodeData]> nodes;
    in property <[LinkData]> links <=> editor.links;
    in-out property <string> grid_commands <=> editor.grid-commands;

    // Size for grid generation
    out property <float> width_: self.width / 1px;
    out property <float> height_: self.height / 1px;

    in-out property <length> pan-x <=> editor.pan-x;
    in-out property <length> pan-y <=> editor.pan-y;
    in-out property <float> zoom <=> editor.zoom;
    out property <length> editor-screen-x: editor.absolute-position.x;
    out property <length> editor-screen-y: editor.absolute-position.y;
    in-out property <BoxSelectionModifier> box-selection-modifier <=> editor.box-selection-modifier;
    in-out property <bool> box-selection-on-empty <=> editor.box-selection-on-empty;
    in-out property <bool> editor-enabled <=> editor.enabled;
    in-out property <bool> editor-visible <=> editor.visible;
    out property <bool> is-selecting: editor.is-selecting;
    out property <bool> is-creating-link: editor.is-creating-link;
    in-out property <int> embedded-control-click-count: 0;
    in property <int> geometry-version: GeometryVersion.version;
    in property <length> test-node-width: 150px;
    in property <length> test-node-height: 100px;
    in-out property <int> test-input-pin-id: 2;
    in-out property <int> test-input-pin-node-id: 1;
    in-out property <int> test-input-pin-type: PinTypes.input;
    in-out property <bool> test-input-pin-visible: true;
    in-out property <bool> test-input-pin-enabled: true;
    out property <LinkPath> observed-link-geometry: NodeEditorComputations.compute-link-path(3, 4, GeometryVersion.version);

    // Additional callbacks for testing
    callback link-requested <=> editor.link-requested;
    callback link-cancelled <=> editor.link-cancelled;
    callback context-menu-requested <=> editor.context-menu-requested;

    // Selection intents — pure gesture reports, applied application-side
    callback node-selected <=> editor.node-selected;
    callback select-link <=> editor.select-link;
    callback selection-cleared <=> editor.selection-cleared;
    callback box-selection-committed <=> editor.box-selection-committed;

    // Link picking is a host callback; standard computations use the exported
    // NodeEditorComputations global.
    callback compute-link-at <=> editor.compute-link-at;

    // Function to refresh links after geometry is reported
    public function refresh-links() {
        editor.refresh-links();
    }

    public function cancel-interactions() {
        editor.cancel-interactions();
    }

    public function focus-editor() {
        editor.focus();
    }
    public function clear-editor-focus() {
        editor.clear-focus();
    }

    in property <bool> focus-controls-enabled: false;
    out property <bool> probe-has-focus: probe.has-focus;
    out property <bool> node-field-has-focus: NodeField.has-focus;
    out property <bool> editor-has-focus: editor.has-focus;
    public function focus-probe() {
        probe.focus();
    }
    public function focus-node-field() {
        NodeField.focus-version += 1;
    }

    editor := NodeEditor {
        width: 100%;
        height: 100%;
        has-link-selection: true;
        minimap-enabled: root.focus-controls-enabled;

        for data in root.nodes: SimpleNode {
            focus-test-enabled: root.focus-controls-enabled;
            node-id: data.id;
            title: data.title;
            world-x: data.x * 1px;
            world-y: data.y * 1px;
            configured-width: root.test-node-width;
            configured-height: root.test-node-height;
            input-pin-id: data.id == 1 ? root.test-input-pin-id : data.id * 2;
            input-pin-node-id: data.id == 1 ? root.test-input-pin-node-id : data.id;
            input-pin-type: data.id == 1 ? root.test-input-pin-type : PinTypes.input;
            input-pin-visible: data.id == 1 ? root.test-input-pin-visible : true;
            input-pin-enabled: data.id == 1 ? root.test-input-pin-enabled : true;
            selected: data.selected;
            embedded-control-clicked => {
                if data.id == 1 {
                    root.embedded-control-click-count += 1;
                }
            }
        }
    }

    probe := TextInput {
        visible: root.focus-controls-enabled;
        x: 700px;
        y: 0px;
        width: 100px;
        height: 20px;
    }
}
