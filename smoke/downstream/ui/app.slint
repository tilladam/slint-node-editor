import { Button, HorizontalBox, VerticalBox } from "std-widgets.slint";
import {
    NodeEditor,
    BaseNode,
    Pin,
    PinTypes,
    NodeEditorInternalCallbacks,
    NodeEditorComputations,
    LinkData,
} from "@nodeeditor";

export struct NodeData {
    id: int,
    title: string,
    x: float,
    y: float,
    selected: bool,
}

// The setup macros refer to these generated global types. LinkData and
// LinkPath are imported from the Rust crate because they cross the library
// module boundary as crate-owned types.
export { PinTypes, NodeEditorInternalCallbacks, NodeEditorComputations }

component QuickNode inherits BaseNode {
    in property <string> title;
    node-width: 180px;
    node-height: 80px;

    Rectangle {
        width: 100%;
        height: 100%;
        background: root.selected ? #315b8a : #30343b;
        border-color: root.selected ? #72b7ff : #606873;
        border-width: 2px;
        border-radius: 6px;

        Text {
            x: 18px;
            y: 12px;
            text: root.title;
            color: white;
        }
    }

    Pin {
        x: 0px;
        y: root.node-height / 2 - self.height / 2;
        pin-id: root.node-id * 2;
        node-id: root.node-id;
        pin-type: PinTypes.input;
        node-screen-x: root.screen-x;
        node-screen-y: root.screen-y;
    }

    Pin {
        x: root.node-width - self.width;
        y: root.node-height / 2 - self.height / 2;
        pin-id: root.node-id * 2 + 1;
        node-id: root.node-id;
        pin-type: PinTypes.output;
        node-screen-x: root.screen-x;
        node-screen-y: root.screen-y;
    }
}

export component App inherits Window {
    title: "Node editor quick start";
    width: 800px;
    height: 520px;

    in property <[NodeData]> nodes;
    in property <[LinkData]> links <=> editor.links;
    in-out property <string> grid-commands <=> editor.grid-commands;
    out property <float> width_: editor.width / 1px;
    out property <float> height_: editor.height / 1px;

    callback add-node-requested();
    callback delete-selected-requested();
    callback link-requested <=> editor.link-requested;
    callback node-selected <=> editor.node-selected;
    callback selection-cleared <=> editor.selection-cleared;
    callback box-selection-committed <=> editor.box-selection-committed;

    VerticalBox {
        spacing: 8px;

        HorizontalBox {
            height: 36px;
            spacing: 8px;
            Button { text: "Add node"; clicked => { root.add-node-requested(); } }
            Button { text: "Delete selected"; clicked => { root.delete-selected-requested(); } }
        }

        editor := NodeEditor {
            for node in root.nodes: QuickNode {
                node-id: node.id;
                title: node.title;
                world-x: node.x * 1px;
                world-y: node.y * 1px;
                selected: node.selected;
            }
        }
    }
}
